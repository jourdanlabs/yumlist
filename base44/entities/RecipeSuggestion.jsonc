{
  "name": "RecipeSuggestion",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "title": "Family ID"
    },
    "recipe_id": {
      "type": "string",
      "title": "Recipe ID"
    },
    "recipe_title": {
      "type": "string",
      "title": "Recipe title"
    },
    "suggested_by_name": {
      "type": "string",
      "title": "Suggested by"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "shopped"
      ],
      "default": "active"
    }
  },
  "required": [
    "family_id",
    "recipe_id",
    "recipe_title",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}