{
  "name": "MemberRole",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "title": "Family ID"
    },
    "member_id": {
      "type": "string",
      "title": "Member ID"
    },
    "member_name": {
      "type": "string",
      "title": "Member name"
    },
    "role": {
      "type": "string",
      "title": "Family role",
      "enum": [
        "parent",
        "adult",
        "teen",
        "child",
        "guest"
      ],
      "enumColors": [
        "purple",
        "blue",
        "yellow",
        "green",
        "gray"
      ],
      "default": "adult"
    }
  },
  "required": [
    "family_id",
    "member_id",
    "role"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}