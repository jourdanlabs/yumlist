{
  "name": "Diet",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "title": "Family ID"
    },
    "name": {
      "type": "string",
      "title": "Diet name"
    },
    "summary": {
      "type": "string",
      "title": "Summary"
    },
    "avoid_ingredients": {
      "type": "array",
      "title": "Ingredients to avoid",
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "type": "array",
      "title": "Key rules",
      "items": {
        "type": "string"
      }
    },
    "active": {
      "type": "boolean",
      "title": "Applied to pantry and recipes",
      "default": false
    },
    "scope": {
      "type": "string",
      "title": "Applies to",
      "enum": [
        "family",
        "member"
      ],
      "default": "family"
    },
    "member_id": {
      "type": "string",
      "title": "Member ID"
    },
    "member_name": {
      "type": "string",
      "title": "Member name"
    },
    "source": {
      "type": "string",
      "title": "Source",
      "default": "search"
    }
  },
  "required": [
    "family_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}