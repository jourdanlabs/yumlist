{
  "name": "GroceryItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Item name"
    },
    "brand": {
      "type": "string",
      "title": "Brand"
    },
    "barcode": {
      "type": "string",
      "title": "Barcode"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL",
      "format": "uri"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "quantity": {
      "type": "number",
      "title": "Quantity in stock",
      "default": 1
    },
    "unit": {
      "type": "string",
      "title": "Unit",
      "enum": [
        "units",
        "packs",
        "boxes",
        "bottles",
        "cans",
        "bags",
        "kg",
        "g",
        "L",
        "mL"
      ],
      "default": "units"
    },
    "expiration_date": {
      "type": "string",
      "title": "Expiration date",
      "format": "date"
    },
    "family_id": {
      "type": "string",
      "title": "Family ID"
    },
    "recipe_title": {
      "type": "string",
      "title": "Requested from recipe"
    },
    "requested_by_name": {
      "type": "string",
      "title": "Requested by"
    }
  },
  "required": [
    "name",
    "family_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}