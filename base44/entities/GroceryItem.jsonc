{
  "name": "GroceryItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Item name"
    },
    "brand": {
      "type": "string",
      "title": "Brand"
    },
    "barcode": {
      "type": "string",
      "title": "Barcode"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL",
      "format": "uri"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "quantity": {
      "type": "number",
      "title": "Quantity in stock",
      "default": 1
    },
    "unit": {
      "type": "string",
      "title": "Unit",
      "enum": [
        "units",
        "packs",
        "boxes",
        "bottles",
        "cans",
        "bags",
        "kg",
        "g",
        "L",
        "mL"
      ],
      "default": "units"
    },
    "expiration_date": {
      "type": "string",
      "title": "Expiration date",
      "format": "date"
    },
    "family_id": {
      "type": "string",
      "title": "Family ID"
    }
  },
  "required": [
    "name",
    "family_id"
  ]
}