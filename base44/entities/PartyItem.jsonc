{
  "name": "PartyItem",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "title": "Family ID"
    },
    "event_id": {
      "type": "string",
      "title": "Event ID"
    },
    "kind": {
      "type": "string",
      "title": "List",
      "enum": [
        "bringing",
        "needed"
      ],
      "default": "bringing",
      "enumColors": [
        "green",
        "yellow"
      ]
    },
    "title": {
      "type": "string",
      "title": "Recipe or item"
    }
  },
  "required": [
    "family_id",
    "event_id",
    "kind",
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}