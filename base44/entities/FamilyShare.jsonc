{
  "name": "FamilyShare",
  "type": "object",
  "properties": {
    "requester_family_id": {
      "type": "string",
      "title": "Requester family ID"
    },
    "target_family_id": {
      "type": "string",
      "title": "Target family ID"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "accepted",
        "disconnected"
      ],
      "default": "pending"
    },
    "requested_by_name": {
      "type": "string",
      "title": "Requested by"
    }
  },
  "required": [
    "requester_family_id",
    "target_family_id",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.requester_family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.requester_family_id": "{{user.data.family_id}}"
        },
        {
          "data.target_family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.target_family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.requester_family_id": "{{user.data.family_id}}"
        },
        {
          "data.target_family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}