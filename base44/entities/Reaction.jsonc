{
  "name": "Reaction",
  "type": "object",
  "properties": {
    "target_type": {
      "type": "string",
      "title": "Target type",
      "enum": [
        "item",
        "recipe"
      ]
    },
    "target_id": {
      "type": "string",
      "title": "Target ID"
    },
    "reaction": {
      "type": "string",
      "title": "Reaction",
      "enum": [
        "like",
        "dislike",
        "neutral"
      ]
    },
    "family_id": {
      "type": "string",
      "title": "Family ID"
    }
  },
  "required": [
    "target_type",
    "target_id",
    "reaction",
    "family_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}