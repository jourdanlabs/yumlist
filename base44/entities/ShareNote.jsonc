{
  "name": "ShareNote",
  "type": "object",
  "properties": {
    "recipient_id": {
      "type": "string",
      "title": "Recipient ID"
    },
    "recipient_name": {
      "type": "string",
      "title": "Recipient name"
    },
    "sender_name": {
      "type": "string",
      "title": "Sender name"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "body": {
      "type": "string",
      "title": "Shared content"
    },
    "kind": {
      "type": "string",
      "title": "Kind",
      "enum": [
        "tastes",
        "recipe"
      ],
      "default": "tastes"
    }
  },
  "required": [
    "recipient_id",
    "title",
    "body"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}