{
  "name": "AffiliateClick",
  "type": "object",
  "properties": {
    "retailer": {
      "type": "string",
      "title": "Store name"
    },
    "item_query": {
      "type": "string",
      "title": "Search query"
    },
    "target_url": {
      "type": "string",
      "title": "Destination URL"
    },
    "family_id": {
      "type": "string",
      "title": "Family ID"
    },
    "user_id": {
      "type": "string",
      "title": "User ID"
    }
  },
  "required": [
    "retailer",
    "target_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}