{
  "name": "PartyPreference",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "title": "Family ID"
    },
    "event_id": {
      "type": "string",
      "title": "Event ID"
    },
    "guest_name": {
      "type": "string",
      "title": "Guest name"
    },
    "item_name": {
      "type": "string",
      "title": "Item"
    },
    "note": {
      "type": "string",
      "title": "Note"
    }
  },
  "required": [
    "family_id",
    "event_id",
    "guest_name",
    "item_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}