{
  "name": "SupportRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "topic": {
      "type": "string",
      "title": "Topic",
      "enum": [
        "account",
        "shopping",
        "recipes",
        "party",
        "bug",
        "other"
      ],
      "default": "other",
      "enumColors": [
        "blue",
        "green",
        "purple",
        "pink",
        "red",
        "gray"
      ]
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "new",
        "resolved"
      ],
      "default": "new",
      "enumColors": [
        "yellow",
        "green"
      ]
    },
    "user_id": {
      "type": "string",
      "title": "User ID"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}