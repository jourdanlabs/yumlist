{
  "description": "Daily email via Gmail when pantry items are nearing their expiration date",
  "name": "Pantry Expiration Alerts",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "pantry_expiration_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyExpiringItems",
            "args": {
              "days_ahead": 3
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send expiration alert",
            "description": "Email items expiring within 3 days"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}